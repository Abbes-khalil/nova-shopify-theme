{% doc %}
  Renders a single category card linking to a merchant-selected collection.
  The card title and URL always come from the selected collection; the image
  falls back to the collection's featured image when no custom image is set.

  @example
  {% content_for 'block', type: 'category-card', id: 'category-card' %}
{% enddoc %}

{% liquid
  assign collection = block.settings.collection
  assign card_image = block.settings.custom_image | default: collection.featured_image
%}

{% if collection != blank %}
  <a
    href="{{ collection.url }}"
    class="category-card"
    {{ block.shopify_attributes }}
  >
    {% if card_image %}
      <div class="category-card__image">
        {{ card_image | image_url: width: 1800 | image_tag: widths: '360, 600, 900, 1200, 1800', sizes: '(min-width: 750px) 60vw, 100vw', loading: 'lazy', alt: card_image.alt }}
      </div>
    {% endif %}

    <span class="category-card__title">{{ block.settings.title | default: collection.title | escape }}</span>
  </a>
{% endif %}

{% stylesheet %}
  .category-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
    color: var(--color-foreground);
    text-decoration: none;
  }

  .category-card__image {
    border-radius: var(--style-border-radius-inputs);
  }

  .category-card__title {
    font-family: var(--font-primary--family);
    font-size: 1rem;
    font-weight: 600;
    text-align: center;
  }
{% endstylesheet %}


{% schema %}
{
  "name": "t:general.category_card",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "t:labels.collection"
    },
    {
      "type": "image_picker",
      "id": "custom_image",
      "label": "t:labels.custom_image",
      "info": "t:labels.custom_image_info"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:labels.heading"
    }
  ]
}
{% endschema %}
