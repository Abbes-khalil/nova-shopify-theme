<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% comment %}
      Font preloading:
      1. Preconnect to font CDN for faster connection
      2. Preload only the critical font variant (base weight)
      3. Additional variants load on-demand via @font-face
    {% endcomment %}
    {% unless settings.type_primary_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

      {% comment %} Preload the base font variant for initial page render {% endcomment %}
      {{ settings.type_primary_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'commerce.css' | asset_url | stylesheet_tag }}
    {{ 'polish.css' | asset_url | stylesheet_tag }}

    {% if request.page_type == 'index' %}
      {% style %}
        {{ settings.editorial_font | font_face: font_display: 'swap' }}
        .nova-editorial-home {
          --editorial-display: {{ settings.editorial_font.family }}, {{ settings.editorial_font.fallback_families }};
          --editorial-ink: {{ settings.editorial_ink }};
          --editorial-bone: {{ settings.editorial_bone }};
          --editorial-warm: {{ settings.editorial_warm }};
          --editorial-muted: {{ settings.editorial_muted }};
          --editorial-accent: {{ settings.editorial_accent }};
        }
      {% endstyle %}
      {{ 'editorial-home.css' | asset_url | stylesheet_tag }}
      <script src="{{ 'editorial-home.js' | asset_url }}" defer></script>
    {% endif %}
    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {% render 'storefront-config' %}
    {{ content_for_header }}
  </head>

  <body{% if request.page_type == 'index' %} class="nova-editorial-home"{% endif %}>
      

    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>
    {% sections 'header-group' %}

    <main id="MainContent" tabindex="-1">{{ content_for_layout }}</main>

    {% section 'cart-drawer' %}
    {% sections 'footer-group' %}
    <script src="{{ 'cart.js' | asset_url }}" defer></script>
  </body>
</html>
