<div class="nova-section">
  <h1 class="nova-page-title">{{ 'cart.title' | t }}</h1>
  <div data-cart-region data-section-id="{{ section.id }}" data-cart-page>{% render 'cart-content', section: section %}</div>
  <p class="nova-form-status" data-cart-status role="status" tabindex="-1"></p>
</div>

{% schema %}
{
  "name": "t:general.cart",
  "settings": [],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  }
}
{% endschema %}
