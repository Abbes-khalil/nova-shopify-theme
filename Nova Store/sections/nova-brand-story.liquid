<section class="nova-section nova-story">{% if section.settings.image %}{{ section.settings.image | image_url: width: 1200 | image_tag: widths: '400, 750, 1000, 1200', sizes: '(min-width: 990px) 50vw, 100vw', loading: 'lazy', alt: section.settings.image.alt }}{% endif %}<div><h2>{{ section.settings.heading | escape }}</h2><div class="nova-richtext">{{ section.settings.description }}</div>{% if section.settings.cta_label != blank and section.settings.cta_url != blank %}<a class="nova-button nova-button--secondary" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label | escape }}</a>{% endif %}</div></section>

{% schema %}
{
  "name": "NOVA brand story",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Made for your everyday"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "NOVA brand story"
    }
  ]
}
{% endschema %}
