<nova-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.product_limit }}&intent=related">
  {% if recommendations.performed and recommendations.products_count > 0 %}<div class="nova-section"><h2 class="nova-page-title">{{ section.settings.heading | escape }}</h2><div class="nova-product-grid">{% for product in recommendations.products %}{% render 'product-card', product: product, show_quick_add: true %}{% endfor %}</div></div>{% endif %}
</nova-recommendations>
<script src="{{ 'recommendations.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "t:general.product_recommendations",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "t:defaults.recommendations_heading"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "t:labels.product_limit",
      "min": 4,
      "max": 8,
      "step": 4,
      "default": 4
    }
  ],
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "presets": [
    {
      "name": "t:general.product_recommendations"
    }
  ]
}
{% endschema %}
