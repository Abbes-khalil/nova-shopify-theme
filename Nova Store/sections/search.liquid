<div class="nova-section">
  <h1 class="nova-page-title">{{ 'search.title' | t }}</h1>
  {% render 'search-form', section: section %}
  {% if search.performed %}
    {% if search.results_count == 0 %}{% assign empty_title = 'search.no_results' | t: terms: search.terms %}{% assign empty_help = 'search.help' | t %}{% render 'empty-state', title: empty_title, message: empty_help %}
    {% else %}
      <p>{{ 'search.results_count' | t: terms: search.terms, count: search.results_count | escape }}</p>
      {% paginate search.results by section.settings.results_per_page %}
        <div class="nova-product-grid">
          {% for result in search.results %}
            {% if result.object_type == 'product' %}{% render 'product-card', product: result, heading_level: 'h2', show_quick_add: true %}
            {% else %}<article class="nova-search-result">{% assign result_image = result.image | default: result.featured_image %}{% if result_image != blank %}<a href="{{ result.url }}">{{ result_image | image_url: width: 750 | image_tag: widths: '360, 540, 750', sizes: '(min-width: 990px) 25vw, 100vw', loading: 'lazy', alt: result_image.alt }}</a>{% endif %}<p class="nova-eyebrow">{% if result.object_type == 'article' %}{{ 'search.articles' | t }}{% else %}{{ 'search.pages' | t }}{% endif %}</p><h2><a href="{{ result.url }}">{{ result.title | escape }}</a></h2><p>{{ result.content | strip_html | truncatewords: 24 | escape }}</p></article>{% endif %}
          {% endfor %}
        </div>
        {% render 'pagination', paginate: paginate %}
      {% endpaginate %}
    {% endif %}
  {% else %}<p>{{ 'search.start' | t }}</p>{% endif %}
</div>
<script src="{{ 'search.js' | asset_url }}" defer></script>


{% schema %}
{
  "name": "t:general.search",
  "settings": [
    {
      "type": "range",
      "id": "results_per_page",
      "label": "t:labels.results_per_page",
      "min": 12,
      "max": 48,
      "step": 12,
      "default": 24
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  }
}
{% endschema %}
