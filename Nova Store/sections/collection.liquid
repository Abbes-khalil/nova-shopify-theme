{% comment %}
  Main collection page section. Shopify provides the contextual collection
  object automatically when this section renders through collection.json.
{% endcomment %}

{% liquid
  assign collection_image_alt = collection.image.alt | default: collection.title | escape
  assign current_sort_by = collection.sort_by | default: collection.default_sort_by
%}

<section class="collection-page" aria-labelledby="CollectionTitle-{{ section.id }}">
  <header class="collection-page__header">
    {% if collection.image %}
      <div class="collection-page__media">
        {{
          collection.image
          | image_url: width: 2000
          | image_tag:
            widths: '550, 750, 1100, 1500, 2000',
            sizes: '(min-width: 1200px) 1150px, 100vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: collection_image_alt,
            class: 'collection-page__image'
        }}
      </div>
    {% endif %}

    <div class="collection-page__intro">
      <h1 id="CollectionTitle-{{ section.id }}" class="collection-page__title">{{ collection.title }}</h1>

      {% if collection.description != blank %}
        <div class="collection-page__description rte">{{ collection.description }}</div>
      {% endif %}

      <p class="collection-page__count">
        {{ 'collections.product_count' | t: count: collection.products_count }}
      </p>
    </div>
  </header>

  <div id="CollectionProductGrid-{{ section.id }}" class="collection-page__products">
    {% if collection.products_count > 0 %}
      <div class="collection-page__toolbar">
        <form
          class="collection-page__sort-form"
          action="{{ collection.url }}"
          method="get"
        >
          <label class="collection-page__sort-label" for="SortBy-{{ section.id }}">
            {{ 'collections.sorting.label' | t }}
          </label>
          <select
            id="SortBy-{{ section.id }}"
            class="collection-page__sort-select"
            name="sort_by"
            aria-controls="ProductGrid-{{ section.id }}"
            data-collection-sort
          >
            {% for option in collection.sort_options %}
              <option
                value="{{ option.value | escape }}"
                {% if option.value == current_sort_by %}
                  selected="selected"
                {% endif %}
              >
                {{ option.name | escape }}
              </option>
            {% endfor %}
          </select>

          <noscript>
            <button class="collection-page__sort-button" type="submit">
              {{ 'collections.sorting.apply' | t }}
            </button>
          </noscript>
        </form>
      </div>

      <ul id="ProductGrid-{{ section.id }}" class="collection-page__grid" role="list">
        {% for product in collection.products %}
          <li class="collection-page__grid-item">
            {% render 'product-card', product: product %}
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <div class="collection-page__empty" role="status">
        <p>{{ 'collections.empty' | t }}</p>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .collection-page {
    padding-block: clamp(2rem, 6vw, 5rem);
  }

  .collection-page__header {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    margin-block-end: clamp(2rem, 5vw, 4rem);
  }

  .collection-page__media {
    overflow: hidden;
    border-radius: var(--style-border-radius-inputs);
  }

  .collection-page__image {
    width: 100%;
    aspect-ratio: 16 / 7;
    object-fit: cover;
  }

  .collection-page__intro {
    max-width: 50rem;
  }

  .collection-page__title {
    color: var(--color-foreground);
    font-family: var(--font-primary--family);
    font-size: clamp(2rem, 5vw, 4rem);
    line-height: 1.05;
  }

  .collection-page__description {
    max-width: 65ch;
    margin-block-start: 1rem;
    color: var(--color-foreground);
    line-height: 1.6;
    opacity: 0.8;
  }

  .collection-page__description > * + * {
    margin-block-start: 0.75rem;
  }

  .collection-page__count {
    margin-block-start: 1rem;
    color: var(--color-foreground);
    font-size: 0.875rem;
    opacity: 0.7;
  }

  .collection-page__toolbar {
    display: flex;
    justify-content: flex-end;
    margin-block-end: clamp(1.5rem, 3vw, 2.5rem);
  }

  .collection-page__sort-form {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-foreground);
  }

  .collection-page__sort-label {
    flex: none;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .collection-page__sort-select {
    min-width: 13rem;
    min-height: 2.75rem;
    padding: 0.625rem 2.25rem 0.625rem 0.75rem;
    border: 1px solid currentcolor;
    cursor: pointer;
  }

  .collection-page__sort-select:focus-visible,
  .collection-page__sort-button:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }

  .collection-page__sort-button {
    min-height: 2.75rem;
    padding: 0.625rem 1rem;
    border: 1px solid var(--color-foreground);
    border-radius: var(--style-border-radius-inputs);
    background-color: var(--color-foreground);
    color: var(--color-background);
    font: inherit;
    cursor: pointer;
  }

  .collection-page__grid {
    --collection-grid-columns: 2;
    --collection-grid-column-gap: clamp(0.75rem, 2vw, 1.5rem);
    --collection-grid-row-gap: clamp(2rem, 4vw, 3.25rem);

    display: grid;
    grid-template-columns: repeat(var(--collection-grid-columns), minmax(0, 1fr));
    align-items: stretch;
    column-gap: var(--collection-grid-column-gap);
    row-gap: var(--collection-grid-row-gap);
    padding: 0;
    list-style: none;
  }

  .collection-page__grid-item {
    display: flex;
    min-width: 0;
  }

  .collection-page__grid-item > .product-card {
    height: 100%;
  }

  .collection-page__grid-item .product-card__content {
    display: flex;
    flex: 1;
    flex-direction: column;
  }

  .collection-page__grid-item .product-card__price-group {
    flex-wrap: wrap;
    margin-block-start: auto;
    padding-block-start: 0.25rem;
  }

  .collection-page__empty {
    display: grid;
    min-height: 12rem;
    place-items: center;
    padding: 2rem var(--page-margin);
    border-block: 1px solid var(--color-foreground);
    color: var(--color-foreground);
    text-align: center;
  }

  @media screen and (max-width: 47.99rem) {
    .collection-page__toolbar,
    .collection-page__sort-form {
      width: 100%;
    }

    .collection-page__sort-select {
      min-width: 0;
      flex: 1;
    }
  }

  @media screen and (min-width: 48rem) {
    .collection-page__grid {
      --collection-grid-columns: 3;
    }
  }

  @media screen and (min-width: 64rem) {
    .collection-page__grid {
      --collection-grid-columns: 4;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('change', (event) => {
    const sortSelect = event.target.closest('[data-collection-sort]');

    if (!sortSelect) return;

    const url = new URL(window.location.href);
    url.searchParams.set('sort_by', sortSelect.value);
    url.searchParams.delete('page');
    window.location.assign(url.toString());
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:general.collection",
  "settings": []
}
{% endschema %}
