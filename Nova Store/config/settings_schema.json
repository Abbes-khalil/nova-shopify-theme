[
  {
    "name": "theme_info",
    "theme_name": "NOVA",
    "theme_version": "0.3.0",
    "theme_author": "Khalil Abbes",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:general.primary"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 48
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "brand_color",
        "default": "#171717",
        "label": "t:labels.brand"
      },
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "t:labels.background"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      },
      {
        "type": "color",
        "id": "surface_color",
        "default": "#F5F5F5",
        "label": "Secondary background"
      },
      {
        "type": "color",
        "id": "secondary_text_color",
        "default": "#737373",
        "label": "Secondary text"
      },
      {
        "type": "color",
        "id": "border_color",
        "default": "#E5E5E5",
        "label": "Border"
      },
      {
        "type": "color",
        "id": "accent_color",
        "default": "#171717",
        "label": "Accent"
      },
      {
        "type": "color",
        "id": "accent_foreground_color",
        "default": "#FFFFFF",
        "label": "Accent text"
      },
      {
        "type": "color",
        "id": "success_color",
        "default": "#166534",
        "label": "Success"
      },
      {
        "type": "color",
        "id": "error_color",
        "default": "#B91C1C",
        "label": "Error"
      }
    ]
  },
  {
    "name": "Spacing and controls",
    "settings": [
      {
        "type": "range",
        "id": "section_spacing",
        "min": 32,
        "max": 96,
        "step": 8,
        "unit": "px",
        "default": 64,
        "label": "Section spacing"
      },
      {
        "type": "range",
        "id": "button_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "default": 0,
        "label": "Button corner radius"
      }
    ]
  }
]
