      },
      {
        "type": "color",
        "id": "secondary_text_color",
        "default": "#737373",
        "label": "t:nova_editor.global_3_settings_4_label"
      },
      {
        "type": "color",
        "id": "border_color",
        "default": "#E5E5E5",
        "label": "t:nova_editor.global_3_settings_5_label"
      },
      {
        "type": "color",
        "id": "accent_color",
        "default": "#171717",
        "label": "t:nova_editor.global_3_settings_6_label"
      },
      {
        "type": "color",
        "id": "accent_foreground_color",
