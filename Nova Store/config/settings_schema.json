  {
    "name": "t:nova_editor.global_4_name",
    "settings": [
      {
        "type": "range",
        "id": "section_spacing",
        "min": 32,
        "max": 96,
        "step": 8,
        "unit": "px",
        "default": 64,
        "label": "t:nova_editor.global_4_settings_0_label"
      },
      {
        "type": "range",
        "id": "button_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "default": 0,
