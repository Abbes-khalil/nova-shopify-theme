        "label": "t:nova_editor.global_3_settings_7_label"
      },
      {
        "type": "color",
        "id": "success_color",
        "default": "#166534",
        "label": "t:nova_editor.global_3_settings_8_label"
      },
      {
        "type": "color",
        "id": "error_color",
        "default": "#B91C1C",
        "label": "t:nova_editor.global_3_settings_9_label"
