{% if paginate.pages > 1 %}
  <nav class="nova-pagination" aria-label="{{ 'catalog.pagination' | t }}">
    {% if paginate.previous %}<a href="{{ paginate.previous.url }}" aria-label="{{ 'catalog.previous' | t }}">&larr;</a>{% endif %}
    {% for part in paginate.parts %}
      {% if part.is_link %}<a href="{{ part.url }}" aria-label="{{ 'catalog.page' | t: number: part.title }}">{{ part.title }}</a>
      {% elsif part.title == paginate.current_page %}<span aria-current="page">{{ part.title }}</span>
      {% else %}<span>{{ part.title }}</span>{% endif %}
    {% endfor %}
    {% if paginate.next %}<a href="{{ paginate.next.url }}" aria-label="{{ 'catalog.next' | t }}">&rarr;</a>{% endif %}
  </nav>
{% endif %}
